{
	"name": "recordly-mcp",
	"version": "0.1.0",
	"description": "MCP server that lets Claude edit and export videos in a running Recordly app.",
	"private": true,
	"type": "module",
	"bin": {
		"recordly-mcp": "dist/index.js"
	},
	"main": "dist/index.js",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"start": "node dist/index.js",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"engines": {
		"node": ">=18"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.0",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"typescript": "^5.9.3"
	}
}
